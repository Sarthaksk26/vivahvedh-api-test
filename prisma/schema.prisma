generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String            @id @default(uuid())
  regId                  String            @unique
  email                  String?           @unique
  mobile                 String            @unique
  password               String
  role                   Role              @default(USER)
  accountStatus          AccountStatus     @default(INACTIVE)
  profileCreatedBy       String?
  requiresPasswordChange Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  paymentDone            Boolean           @default(false)
  lastPaidOn             DateTime?
  planType               PlanType          @default(FREE)
  planExpiresAt          DateTime?
  kycDocumentUrl         String?
  kycType                KYCType?
  kycVerified            Boolean           @default(false)
  images                 Image[]
  pendingPayments        PendingPayment[]
  profileViewsReceived   ProfileView[]     @relation("ViewedProfile")
  profileViewsSent       ProfileView[]     @relation("ViewerProfile")
  receivedRequests       Request[]         @relation("ReceivedRequests")
  sentRequests           Request[]         @relation("SentRequests")
  shortlistedBy          Shortlist[]       @relation("ShortlistedBy")
  shortlistedUsers       Shortlist[]       @relation("ShortlistedUsers")
  refreshTokens          RefreshToken[]
  addresses              UserAddress[]
  astrology              UserAstrology?
  education              UserEducation?
  family                 UserFamily?
  physical               UserPhysical?
  preferences            UserPreferences?
  profile                UserProfile?
  birthdayWishes         BirthdayWishLog[]
  notifications          UserNotification[]
  passwordResetTokens    PasswordResetToken[]
  reportsMade            Report[]          @relation("ReportedBy")
  reportsReceived        Report[]          @relation("ReportedUsers")

  @@index([planType, createdAt(sort: Desc)])
  @@index([role, accountStatus])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  firstName     String
  middleName    String        @default("")
  lastName      String
  gender        Gender
  maritalStatus MaritalStatus
  birthDateTime DateTime?
  birthPlace    String?
  aboutMe       String?
  religionId    Int?
  casteId       Int?
  subCasteId    Int?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender, maritalStatus, casteId])
  @@index([religionId, casteId, subCasteId])
  @@index([birthDateTime])
}

model UserPhysical {
  id               String   @id @default(uuid())
  userId           String   @unique
  height           String?
  weight           Int?
  bloodGroup       String?
  complexion       String?
  health           String?
  disease          String?
  diet             String?
  smoke            Boolean?
  drink            Boolean?
  medicalReportUrl String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAstrology {
  id        String  @id @default(uuid())
  userId    String  @unique
  gothra    String?
  rashi     String?
  nakshatra String?
  charan    String?
  nadi      String?
  gan       String?
  mangal    String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserEducation {
  id                 String  @id @default(uuid())
  userId             String  @unique
  qualificationId    Int?
  trade              String?
  college            String?
  jobBusiness        String?
  jobAddress         String?
  annualIncome       String?
  specialAchievement String?
  incomeProofUrl     String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserFamily {
  id                String  @id @default(uuid())
  userId            String  @unique
  fatherName        String?
  fatherOccupation  String?
  motherName        String?
  motherOccupation  String?
  motherHometown    String?
  maternalUncleName String?
  brothers          Int     @default(0)
  marriedBrothers   Int     @default(0)
  sisters           Int     @default(0)
  marriedSisters    Int     @default(0)
  relativesSirnames String?
  familyBackground  String?
  familyWealth      String?
  agricultureLand   String?
  plot              String?
  flat              String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id           String  @id @default(uuid())
  userId       String  @unique
  expectations String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAddress {
  id          String  @id @default(uuid())
  userId      String
  addressType String
  addressLine String?
  city        String?
  district    String?
  state       String?
  talukaId    Int?
  districtId  Int?
  stateId     Int?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, district, city])
}

model Image {
  id        String   @id @default(uuid())
  userId    String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
}

model Request {
  id         String        @id @default(uuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  receiver   User          @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User          @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId, createdAt])
  @@index([status])
  @@index([receiverId, status])
}

model Shortlist {
  id           String   @id @default(uuid())
  userId       String
  targetUserId String
  createdAt    DateTime @default(now())
  target       User     @relation("ShortlistedBy", fields: [targetUserId], references: [id], onDelete: Cascade)
  user         User     @relation("ShortlistedUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId])
}

model ProfileView {
  id       String   @id @default(uuid())
  viewerId String
  viewedId String
  viewedAt DateTime @default(now())
  viewed   User     @relation("ViewedProfile", fields: [viewedId], references: [id], onDelete: Cascade)
  viewer   User     @relation("ViewerProfile", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@index([viewedId, viewedAt])
}

model Enquiry {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  email      String
  mobile     String
  subject    String
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isResolved, createdAt])
}

model PendingPayment {
  id            String        @id @default(uuid())
  userId        String
  planType      PlanType
  amount        Float
  screenshotUrl String
  transactionId String
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId])
  @@unique([userId, transactionId])
  @@index([status, createdAt])
}

model Religion {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Caste {
  id         Int    @id @default(autoincrement())
  religionId Int?
  name       String
}

model SubCaste {
  id      Int    @id @default(autoincrement())
  casteId Int?
  name    String
}

model State {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model District {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Taluka {
  id         Int    @id @default(autoincrement())
  districtId Int?
  name       String
}

model IncomeRange {
  id    Int    @id @default(autoincrement())
  range String @unique
}

model Qualification {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  group String?
}

model Occupation {
  id   Int    @id @default(autoincrement())
  type String @unique
}

model SuccessStory {
  id          String      @id @default(uuid())
  groomName   String
  brideName   String
  message     String      @db.Text
  photoUrl    String?
  status      StoryStatus @default(PENDING)
  submittedBy String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
}

enum StoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

enum KYCType {
  AADHAR
  PAN
  PASSPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  UNMARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanType {
  FREE
  SILVER
  GOLD
}

enum NotificationType {
  PROPOSAL_SENT
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PROFILE_APPROVED
}

model UserNotification {
  id               String             @id @default(uuid())
  userId           String
  type             NotificationType
  message          String             @db.Text
  isRead           Boolean            @default(false)
  relatedUserId    String?
  createdAt        DateTime           @default(now())

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead, createdAt])
}

model BirthdayWishLog {
  id          String   @id @default(uuid())
  userId      String
  emailSentTo String
  message     String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique  // Store HASHED token, not raw
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshTokenGrace {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model Report {
  id               String       @id @default(uuid())
  reporterId       String
  reportedUserId   String
  reason           String
  description      String?      @db.Text
  status           ReportStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reporter         User         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser     User         @relation("ReportedUsers", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String
  action       String   // PASSWORD_RESET, OFFLINE_USER_CREATED, etc.
  details      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([action, createdAt(sort: Desc)])
}
