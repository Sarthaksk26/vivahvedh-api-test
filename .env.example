# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# Auth Secrets (IMPORTANT: generate strong random values for production)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_refresh_token_secret_here"
PII_ENCRYPTION_KEY="your_64_character_hex_key_here"

# Admin bootstrap password (used by scripts/set-admin-pass.js & scripts/cleanup-users.ts).
# Set a strong, unique value locally; never commit the real password to git.
ADMIN_PASSWORD="change-me-strong-password"

# SMTP Configuration (Gmail: use App Password from Google Account > Security)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="user@gmail.com"
SMTP_PASS="your_gmail_app_password_here"

# Email Testing Mode
# Set to "true" to use Ethereal (fake SMTP) — emails are captured in a web inbox
# instead of being sent to real addresses. Great for development/testing.
# View captured emails at: https://ethereal.email/login
EMAIL_TEST=""

# Client URL (your frontend domain — used for CORS, email links, etc.)
CLIENT_URL="http://localhost:5173"

# CORS Origins (comma-separated list of allowed frontend origins)
# In production, set to your actual domain e.g. "https://vivahvedh.com"
CORS_ORIGINS=""

# Environment (set to "production" on your hosting platform)
NODE_ENV="development"

# Cloudinary (REQUIRED — server will not start without these)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

